<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows to match InfiniContext.Gui.UiaDriver (see the comment there). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- xunit.v3 test projects are self-contained executables (matches InfiniContext.Tests). -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No coverlet here on purpose: the UIA suite is opt-in (ICX_UIA_TESTS=1), runs against the
       real exe from outside, and collects no coverage (design.md section 6.4). -->
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfiniContext.Gui.UiaDriver\InfiniContext.Gui.UiaDriver.csproj" />
    <!-- Build-order only: the suite spawns InfiniContext.Gui.exe and FakeClaude.exe from their
         bin folders, so 'dotnet test' on this project must have built both. -->
    <ProjectReference Include="..\..\src\InfiniContext.Gui\InfiniContext.Gui.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FakeClaude\FakeClaude.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
