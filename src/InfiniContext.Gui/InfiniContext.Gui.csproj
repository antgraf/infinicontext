<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfiniContext.Core\InfiniContext.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfiniContext.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Phase 3B scaffolding. Avalonia 11.x is the cross-platform Win+Mac stack picked
      in infinicontext-initial-design.md s6.1 and confirmed in stage2/decisions.md s13.
      CommunityToolkit.Mvvm is the recommended MVVM flavour per Phase 3A design.md s10 #1.
    -->
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <!--
      Avalonia.Diagnostics has not shipped a 12.x release yet (latest 11.3.16 as of 2026-05-20).
      Mixing Diagnostics 11.x with Avalonia 12.x is unsafe - the debugger overlay hooks Avalonia
      internals. Re-add this reference when AvaloniaUI/Avalonia.Diagnostics 12.x is published.
    -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      Markdown rendering inside the transcript's per-turn cards. The 12.0.0-aN line is the only
      one targeting Avalonia 12 (the stable 11.x line is pinned to Avalonia 11); pre-release pin
      is intentional and will be lifted when whistyun ships a stable 12.x. a3 minimum: a2's
      DivideColorExtension publishes a raw Color into IBrush properties when its DynamicResource
      leg unsets during detach - InvalidCastException, whistyun/Markdown.Avalonia#183, fixed in
      a3 via PR #184 (task 0016).
    -->
    <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
  </ItemGroup>

</Project>
