<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="360"
        x:Class="InfiniContext.Gui.Views.NewTaskDialog"
        Title="New task"
        Width="520" Height="380"
        MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Name="CancelButton" Content="Cancel" />
      <Button Name="CreateButton" Content="Create" Classes="accent" IsDefault="True" />
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Text="Create a new InfiniContext task" FontWeight="SemiBold" />
      <TextBlock Text="The task title is generated automatically from the description by the light model."
                 FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

      <StackPanel Spacing="3">
        <TextBlock Text="Home folder" FontSize="11" Opacity="0.7" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Name="HomeCwdBox" PlaceholderText="Pick a folder..." />
          <Button Grid.Column="1" Name="BrowseButton" Content="Browse..." Margin="6,0,0,0" />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Description" FontSize="11" Opacity="0.7" />
        <TextBox Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="120"
                 PlaceholderText="Describe what the task should accomplish. The agent will read this from description.md when it starts." />
      </StackPanel>

      <TextBlock Name="ErrorLabel" Foreground="#FFB00000" FontSize="11" IsVisible="False" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
