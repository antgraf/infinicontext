<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InfiniContext.Gui.ViewModels"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="InfiniContext.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="InfiniContext"
        MinWidth="720" MinHeight="480"
        Width="1100" Height="700">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Styles>
    <!-- Compact Expander: the Fluent default leaves ~24 DIP of vertical padding around the toggle
         row, which doubles the height of an otherwise-one-line "Details" pill in every turn. We
         flatten the toggle area and downsize its typography to match the surrounding metadata
         (small + low-opacity) so the toggle reads as a hint, not a prominent control. -->
    <Style Selector="Expander">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <!-- MarkdownScrollViewer alpha (12.0.0-a2) renders paragraphs into TextBlock-derived controls
         that don't get TextWrapping="Wrap" by default, so long lines run off the right edge of the
         card. Force wrapping on every text element inside any md:MarkdownScrollViewer in this
         window. (Codeblocks intentionally keep NoWrap - those should H-scroll inside the fence.) -->
    <Style Selector="md|MarkdownScrollViewer TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="md|MarkdownScrollViewer SelectableTextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Status strip -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemAccentColorBrush}" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="InfiniContext" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="White" Opacity="0.85" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Footer / log path -->
    <Border DockPanel.Dock="Bottom" Padding="12,4" Background="{DynamicResource SystemBaseLowColor}">
      <TextBlock Text="{Binding LogFilePath}" FontSize="11" Opacity="0.7" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LeftColumnWidth, Mode=TwoWay}"
                          MinWidth="{Binding LeftColumnMinWidth}"
                          MaxWidth="{Binding LeftColumnMaxWidth}" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <!-- Tasks &amp; Sessions tree -->
      <Border Grid.Column="0" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="8">
            <Button Content="+ New task" Command="{Binding NewTaskCommand}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Create a new InfiniContext task. (Stub - dialog wiring lands in the next slice.)" />
          </Border>
          <TreeView ItemsSource="{Binding TaskNodes}"
                    SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                    BorderThickness="0">
            <TreeView.DataTemplates>
              <TreeDataTemplate x:DataType="vm:TaskNodeViewModel" ItemsSource="{Binding Sessions}">
                <!-- Row content stacked vertically so a long title can't push the action bar off
                     the right edge of the panel. Title text gets explicit TextTrimming so a wide
                     row doesn't trigger a horizontal TreeView scroll. -->
                <StackPanel Margin="0,4">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontFamily="Segoe UI Symbol, Apple Color Emoji, Segoe UI Emoji" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding HeaderId, Mode=OneWay}" FontFamily="Consolas, Menlo, monospace" FontWeight="SemiBold" />
                        <Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding HomeCwd}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsSynthetic}" />
                    </StackPanel>
                  </Grid>
                  <!-- Action bar: under the row content, indented to align with the title column.
                       Bound to the root VM via $parent[TreeView]; the row VM travels as parameter. -->
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="22,3,0,0">
                    <Button Content="+"
                            Classes="rowAction"
                            ToolTip.Tip="Spawn a new claude session under this task"
                            Command="{Binding $parent[TreeView].DataContext.SpawnSessionForTaskCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </TreeDataTemplate>
              <DataTemplate x:DataType="vm:SessionRowViewModel">
                <StackPanel Margin="0,2">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding StatusGlyph, Mode=OneWay}" FontFamily="Segoe UI Symbol, Apple Color Emoji, Segoe UI Emoji" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding ShortId}" FontFamily="Consolas, Menlo, monospace" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Cwd}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                      <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding State, Mode=OneWay}" />
                        <Run Text=" &#xB7; drift " /><Run Text="{Binding Drift, Mode=OneWay}" />
                        <Run Text=" &#xB7; " /><Run Text="{Binding CostDisplay, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                  <!-- Action bar: canned prompts to this session (not necessarily the focused one). -->
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="20,3,0,0">
                    <Button Content="&#x25B6;"
                            Classes="rowAction"
                            ToolTip.Tip="Send 'Continue with the task.' to this session"
                            Command="{Binding $parent[TreeView].DataContext.SendContinueCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="?"
                            Classes="rowAction"
                            ToolTip.Tip="Send 'What's next for the task?' to this session"
                            Command="{Binding $parent[TreeView].DataContext.SendWhatsNextCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </TreeView.DataTemplates>
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True" />
              </Style>
              <!-- Compact action buttons: borderless square chips that don't dominate the row. -->
              <Style Selector="Button.rowAction">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </TreeView.Styles>
          </TreeView>
        </DockPanel>
      </Border>

      <!-- Vertical splitter between the Tasks tree and the transcript. The left column's
           ColumnDefinition.Width is two-way bound to the VM's LeftColumnWidth, so dragging here
           updates the VM directly and the splitter doesn't need an event hook. -->
      <GridSplitter Grid.Column="1" Width="6"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    Background="{DynamicResource SystemBaseLowColor}" />

      <!-- Focused session transcript. DockPanel (was Grid RowDefinitions="*,Auto") so the prompt
           Border at the bottom is sized first and the ScrollViewer always sees a stable height;
           the Grid layout was lagging one pass behind when the multi-line TextBox grew, which
           prevented the operator from scrolling all the way to the most recent turn. -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Padding="8">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Name="PromptBox"
                     Text="{Binding PromptText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60" MaxHeight="180"
                     PlaceholderText="Type a prompt. Ctrl+Enter to send, Esc to interrupt."
                     IsEnabled="{Binding FocusedSession, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendPromptCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding InterruptCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" HorizontalAlignment="Right">
              <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll, Mode=TwoWay}" VerticalAlignment="Center" FontSize="11" />
              <Button Content="Interrupt (Esc)" Command="{Binding InterruptCommand}" />
              <Button Content="Send (Ctrl+Enter)" Command="{Binding SendPromptCommand}" Classes="accent" />
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Name="TranscriptScroll" Padding="12,12,12,16">
          <ItemsControl ItemsSource="{Binding FocusedSession.Turns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TurnNodeViewModel">
                <Border Margin="0,4,0,8" Padding="10" CornerRadius="4"
                        BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
                        Background="{DynamicResource SystemAltLowColor}">
                  <StackPanel Spacing="6">
                    <!-- Operator block: visible only when this turn carries a real user prompt.
                         Synthetic markers like "(claude-initiated)" / "(session start)" set
                         HasOperatorMessage=false so the block stays hidden. Label intentionally
                         small + grey so it reads as a speaker tag, not a heading. -->
                    <StackPanel Spacing="2" IsVisible="{Binding HasOperatorMessage}">
                      <TextBlock Text="{Binding OperatorLabel}" FontSize="11" Opacity="0.7" />
                      <md:MarkdownScrollViewer Markdown="{Binding UserPrompt, Mode=OneWay}"
                                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                               ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                    </StackPanel>

                    <!-- Agent block: visible only when a real assistant headline has arrived. While
                         IsInProgress and Headline is still the "thinking..." placeholder, the entire
                         block (label + body) hides so the card reads as "operator + details". The
                         small in-progress indicator below preserves the "claude is working" signal. -->
                    <StackPanel Spacing="2" IsVisible="{Binding HasHeadline}">
                      <TextBlock Text="{Binding AgentLabel}" FontSize="11" Opacity="0.7" />
                      <md:MarkdownScrollViewer Markdown="{Binding Headline, Mode=OneWay}"
                                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                               ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                    </StackPanel>

                    <!-- Lightweight progress hint - visible only while the turn is mid-flight and
                         the Agent block is still hidden (i.e. before the first assistant text). -->
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInProgress}">
                      <TextBlock Text="&#x23F3;" FontSize="11" Opacity="0.6" />
                      <TextBlock Text="thinking..." FontSize="11" Opacity="0.55" />
                    </StackPanel>

                    <!-- Footer: cost / turns / duration once the result event lands -->
                    <TextBlock Text="{Binding FooterSummary, Mode=OneWay}" FontSize="10" Opacity="0.55"
                               IsVisible="{Binding FooterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Expandable children: thinking, tool-use, tool-result, system events -->
                    <Expander Header="Details" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              IsVisible="{Binding Children.Count, Converter={x:Static ObjectConverters.IsNotNull}}"
                              FontSize="11">
                      <ItemsControl ItemsSource="{Binding Children}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TurnContentItemViewModel">
                            <Border Padding="4,2" Margin="0,2">
                              <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" FontSize="11">
                                <Expander.Header>
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol, Apple Color Emoji, Segoe UI Emoji" FontSize="12" />
                                    <TextBlock Text="{Binding Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                </Expander.Header>
                                <SelectableTextBlock Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap"
                                                     FontFamily="Consolas, Menlo, monospace" FontSize="11" Margin="20,4,4,4" />
                              </Expander>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Inspector -->
      <Border Grid.Column="3" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1,0,0,0" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Inspector" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedTaskNode.Title, FallbackValue='(no task selected)'}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedTaskNode.HomeCwd, FallbackValue=''}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
          <Separator Margin="0,4" />
          <TextBlock Text="Focused session" FontSize="11" Opacity="0.6" />
          <TextBlock Text="{Binding FocusedSession.Cwd, FallbackValue='(no session focused)'}" TextWrapping="Wrap" Opacity="0.85" />
          <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                     Text="Phase 3B scaffold. Tool calls auto-deny while the GUI's auto-mode wiring is pending. + New task / + New session under selected task / approval banner land in later slices." />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
