<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InfiniContext.Gui.ViewModels"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="InfiniContext.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="InfiniContext"
        MinWidth="720" MinHeight="480"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Styles>
    <!-- Compact Expander: the Fluent default leaves ~24 DIP of vertical padding around the toggle
         row, which doubles the height of an otherwise-one-line "Details" pill in every turn. We
         flatten the toggle area and downsize its typography to match the surrounding metadata
         (small + low-opacity) so the toggle reads as a hint, not a prominent control. -->
    <Style Selector="Expander">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <!-- MarkdownScrollViewer alpha (12.0.0-a2) renders paragraphs into TextBlock-derived controls
         that don't get TextWrapping="Wrap" by default, so long lines run off the right edge of the
         card. Force wrapping on every text element inside any md:MarkdownScrollViewer in this
         window. (Codeblocks intentionally keep NoWrap - those should H-scroll inside the fence.) -->
    <Style Selector="md|MarkdownScrollViewer TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="md|MarkdownScrollViewer SelectableTextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Per-turn card. Hosted by the per-session ItemsControl that MainWindow.axaml.cs builds
         once per session (see the transcript host below), so no item container - and none of
         the alpha Markdown.Avalonia visuals inside it - is ever reused across sessions. -->
    <DataTemplate x:Key="TurnNodeTemplate" x:DataType="vm:TurnNodeViewModel">
      <Border Margin="0,4,0,8" Padding="10" CornerRadius="4"
              BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
              Background="{DynamicResource SystemAltLowColor}">
        <StackPanel Spacing="6">
          <!-- Operator block: visible only when this turn carries a real user prompt.
               Synthetic markers like "(claude-initiated)" / "(session start)" set
               HasOperatorMessage=false so the block stays hidden. Label intentionally
               small + grey so it reads as a speaker tag, not a heading. -->
          <StackPanel Spacing="2" IsVisible="{Binding HasOperatorMessage}">
            <TextBlock Text="{Binding OperatorLabel}" FontSize="11" Opacity="0.7" />
            <md:MarkdownScrollViewer Markdown="{Binding UserPrompt, Mode=OneWay}"
                                     SelectionEnabled="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
          </StackPanel>

          <!-- Agent block: visible only when a real assistant headline has arrived. While
               IsInProgress and Headline is still the "thinking..." placeholder, the entire
               block (label + body) hides so the card reads as "operator + details". The
               small in-progress indicator below preserves the "claude is working" signal. -->
          <StackPanel Spacing="2" IsVisible="{Binding HasHeadline}">
            <TextBlock Text="{Binding AgentLabel}" FontSize="11" Opacity="0.7" />
            <md:MarkdownScrollViewer Markdown="{Binding Headline, Mode=OneWay}"
                                     SelectionEnabled="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
          </StackPanel>

          <!-- Lightweight progress hint - visible only while the turn is mid-flight and
               the Agent block is still hidden (i.e. before the first assistant text). -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInProgress}">
            <TextBlock Text="&#x23F3;" FontSize="11" Opacity="0.6" />
            <TextBlock Text="thinking..." FontSize="11" Opacity="0.55" />
          </StackPanel>

          <!-- Footer: cost / turns / duration once the result event lands -->
          <TextBlock Text="{Binding FooterSummary, Mode=OneWay}" FontSize="10" Opacity="0.55"
                     IsVisible="{Binding FooterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- Expandable children: thinking, tool-use, tool-result, system events -->
          <Expander Header="Details" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                    IsVisible="{Binding Children.Count, Converter={x:Static ObjectConverters.IsNotNull}}"
                    FontSize="11">
            <ItemsControl ItemsSource="{Binding Children}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TurnContentItemViewModel">
                  <Border Padding="4,2" Margin="0,2">
                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" FontSize="11">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol, Apple Color Emoji, Segoe UI Emoji" FontSize="12" />
                          <TextBlock Text="{Binding Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Expander.Header>
                      <SelectableTextBlock Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap"
                                           FontFamily="Consolas, Menlo, monospace" FontSize="11" Margin="20,4,4,4" />
                    </Expander>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Status strip. Includes:
         - Title (left).
         - "Approval" ComboBox (host-wide effective mode, D12). Picking a value calls
           SessionHost.SwitchApprovalMode, which iterates SessionManager.Active and hot-swaps
           every session's SwitchableApprovalSink inner. Auto -> Ask fallback on light-model
           construct failure syncs back via SessionHost.ApprovalModeChanged.
         - "Agent busy" indicator (visible while the focused session has a turn in flight).
         - StatusText (right). -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemAccentColorBrush}" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="InfiniContext" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="Approval" Foreground="White" Opacity="0.85" FontSize="11" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ApprovalModes}"
                    SelectedItem="{Binding CurrentApprovalMode, Mode=TwoWay}"
                    MinWidth="92" FontSize="11"
                    ToolTip.Tip="Tool-approval mode for every active session. Ask = banner per call; Deny = auto-reject; Allow = auto-approve (use sparingly); Auto = light-model safety review." />
        </StackPanel>
        <Border Grid.Column="2" IsVisible="{Binding IsAgentBusy}"
                Background="#33FFFFFF" CornerRadius="2" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding AgentBusyHint}" Foreground="White" FontSize="11" />
        </Border>
        <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="White" Opacity="0.85" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Footer / log path -->
    <Border DockPanel.Dock="Bottom" Padding="12,4" Background="{DynamicResource SystemBaseLowColor}">
      <!-- AutomationId doubles as the UIA harness's "host is ready" beacon: the placeholder VM
           leaves LogFilePath empty; the live VM (post-CreateAsync) always carries the per-run
           log path. GuiAppHarness.WaitForHostReady polls this label's UIA Name (task 0020). -->
      <TextBlock AutomationProperties.AutomationId="LogFilePathLabel" Text="{Binding LogFilePath}" FontSize="11" Opacity="0.7" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LeftColumnWidth, Mode=TwoWay}"
                          MinWidth="{Binding LeftColumnMinWidth}"
                          MaxWidth="{Binding LeftColumnMaxWidth}" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <!-- Tasks &amp; Sessions tree -->
      <Border Grid.Column="0" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="8">
            <Button Name="NewTaskButton" AutomationProperties.AutomationId="NewTaskButton"
                    Content="+ New task" Command="{Binding NewTaskCommand}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Create a new InfiniContext task. (Stub - dialog wiring lands in the next slice.)" />
          </Border>
          <TreeView Name="SessionTree" AutomationProperties.AutomationId="SessionTree"
                    ItemsSource="{Binding TaskNodes}"
                    SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                    BorderThickness="0">
            <TreeView.DataTemplates>
              <TreeDataTemplate x:DataType="vm:TaskNodeViewModel" ItemsSource="{Binding Sessions}">
                <!-- Row content stacked vertically so a long title can't push the action bar off
                     the right edge of the panel. Title text gets explicit TextTrimming so a wide
                     row doesn't trigger a horizontal TreeView scroll. -->
                <StackPanel Margin="0,4">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontFamily="Segoe UI Symbol, Apple Color Emoji, Segoe UI Emoji" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding HeaderId, Mode=OneWay}" FontFamily="Consolas, Menlo, monospace" FontWeight="SemiBold" />
                        <Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding HomeCwd}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsSynthetic}" />
                    </StackPanel>
                  </Grid>
                  <!-- Action bar: under the row content, indented to align with the title column.
                       Bound to the root VM via $parent[TreeView]; the row VM travels as parameter. -->
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="22,3,0,0">
                    <Button Content="+"
                            Classes="rowAction"
                            ToolTip.Tip="Spawn a new claude session under this task"
                            Command="{Binding $parent[TreeView].DataContext.SpawnSessionForTaskCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </TreeDataTemplate>
              <!-- TreeDataTemplate (not plain DataTemplate) is required so each session row gets
                   wrapped in its own TreeViewItem and becomes individually selectable. With a plain
                   DataTemplate, clicks on a child row bubble up to the parent task's TreeViewItem,
                   and SelectedItem ends up pointing at the parent - the transcript pane never
                   switches sessions. -->
              <TreeDataTemplate x:DataType="vm:SessionRowViewModel">
                <StackPanel Margin="0,2">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding StatusGlyph, Mode=OneWay}" FontFamily="Segoe UI Symbol, Apple Color Emoji, Segoe UI Emoji" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Queued-prompt badge (task 0012 finding #7 / docs/todo.md #9). Visible
                             only when the glue buffer has at least one prompt waiting on the next
                             Idle transition - tells the operator their typed prompts are buffered
                             and will be sent as one combined claude turn. -->
                        <Border IsVisible="{Binding HasQueuedPrompts}"
                                Background="#FF8800" CornerRadius="6" Padding="4,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Pending prompts will be glued and sent as one claude turn when the agent goes Idle.">
                          <TextBlock Text="{Binding QueuedPromptCount, StringFormat='+{0}'}"
                                     Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding ShortId}" FontFamily="Consolas, Menlo, monospace" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Text="{Binding Cwd}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                      <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding State, Mode=OneWay}" />
                        <Run Text=" &#xB7; drift " /><Run Text="{Binding Drift, Mode=OneWay}" />
                        <Run Text=" &#xB7; " /><Run Text="{Binding CostDisplay, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                  <!-- Action bar: canned prompts to this session (not necessarily the focused one). -->
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="20,3,0,0">
                    <Button Content="&#x25B6;"
                            Classes="rowAction"
                            ToolTip.Tip="Send 'Continue with the task.' to this session"
                            IsEnabled="{Binding IsReady}"
                            Command="{Binding $parent[TreeView].DataContext.SendContinueCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="?"
                            Classes="rowAction"
                            ToolTip.Tip="Send 'What's next for the task?' to this session"
                            IsEnabled="{Binding IsReady}"
                            Command="{Binding $parent[TreeView].DataContext.SendWhatsNextCommand}"
                            CommandParameter="{Binding}" />
                    <!-- M22: stop the in-flight host slash-command on this row (e.g. /task review).
                         Only visible while one is running. -->
                    <Button Content="&#x25A0;"
                            Classes="rowAction"
                            IsVisible="{Binding HostCommandRunning}"
                            ToolTip.Tip="Stop the running command on this session"
                            Command="{Binding $parent[TreeView].DataContext.StopHostCommandCommand}"
                            CommandParameter="{Binding}" />
                    <!-- M21: close/retire this session. Works on a live (kills the child) or dead
                         (reclaims the lingering context) session; routed through CloseSessionAsync. -->
                    <Button Content="&#x2715;"
                            Classes="rowAction"
                            ToolTip.Tip="Close this session (retires it; kills the child if still running)"
                            Command="{Binding $parent[TreeView].DataContext.CloseSessionCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
            <TreeView.Styles>
              <!-- TreeViewItem.IsExpanded is TwoWay-bound (via reflection, NOT compiled bindings)
                   to the data context's IsExpanded property. TaskNodeViewModel defaults that to
                   true so task rows start unfolded; SessionRowViewModel has no IsExpanded so the
                   FallbackValue=False keeps session rows in default state (they are leaves
                   anyway, no children to expand). Reflection binding is required because compiled
                   bindings resolve against the window's x:DataType (MainWindowViewModel) and
                   would fail the type-check inside this Style scope. The previous slice 4a
                   "IsExpanded=True" static setter was a continuous Style assignment that
                   reapplied on container updates and overrode operator collapse clicks - task
                   0012 finding #9. -->
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay, FallbackValue=False}" />
              </Style>
              <!-- Compact action buttons: borderless square chips that don't dominate the row. -->
              <Style Selector="Button.rowAction">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </TreeView.Styles>
          </TreeView>
        </DockPanel>
      </Border>

      <!-- Vertical splitter between the Tasks tree and the transcript. The left column's
           ColumnDefinition.Width is two-way bound to the VM's LeftColumnWidth, so dragging here
           updates the VM directly and the splitter doesn't need an event hook. -->
      <GridSplitter Grid.Column="1" Width="6"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    Background="{DynamicResource SystemBaseLowColor}" />

      <!-- Focused session transcript. DockPanel (was Grid RowDefinitions="*,Auto") so the prompt
           Border at the bottom is sized first and the ScrollViewer always sees a stable height;
           the Grid layout was lagging one pass behind when the multi-line TextBox grew, which
           prevented the operator from scrolling all the way to the most recent turn. -->
      <DockPanel Grid.Column="2">
        <!-- Approval banner (slice 4i). Docked to Top so it sits below the status strip and above
             the transcript. Visible only while the focused session has a pending tool-call
             approval; the slot's Changed event flips IsAwaitingApproval on the session VM. The
             session's SlotApprovalSink (Core, writeTranscriptBanner=false in the GUI) is what
             parks each request in the slot. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding FocusedSession.IsAwaitingApproval, FallbackValue=False}"
                Background="#FFFFF3CD"
                BorderBrush="#FFD9B441" BorderThickness="0,0,0,2"
                Padding="12,8">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="#FF6B4E00">
              <Run Text="Approval requested: " />
              <Run Text="{Binding FocusedSession.PendingToolName, Mode=OneWay}" FontFamily="Consolas, Menlo, monospace" />
            </TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FocusedSession.PendingDeadlineText, Mode=OneWay}"
                       FontSize="11" Opacity="0.7" Foreground="#FF6B4E00" VerticalAlignment="Center" />
            <!-- Explicit Foreground so the JSON dump stays readable in dark theme. Without it
                 SelectableTextBlock inherits the theme foreground (white in dark Fluent), which
                 is invisible on the light-yellow banner. Matches the header amber. -->
            <SelectableTextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 Text="{Binding FocusedSession.PendingInputSummary, Mode=OneWay}"
                                 FontFamily="Consolas, Menlo, monospace" FontSize="11"
                                 Foreground="#FF6B4E00"
                                 TextWrapping="Wrap" Margin="0,4,0,6"
                                 MaxHeight="160" />
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
              <Button Content="Deny" Command="{Binding FocusedSession.DenyCommand}"
                      Background="#FFE8C770" Foreground="#FF6B4E00" BorderBrush="#FFD9B441" />
              <Button Content="Approve" Command="{Binding FocusedSession.ApproveCommand}" Classes="accent" />
            </StackPanel>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Padding="8">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Name="PromptBox" AutomationProperties.AutomationId="PromptBox"
                     Text="{Binding PromptText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60" MaxHeight="180"
                     PlaceholderText="Type a prompt. Ctrl+Enter to send, Esc to interrupt."
                     IsEnabled="{Binding FocusedSession, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendPromptCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding InterruptCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" HorizontalAlignment="Right">
              <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll, Mode=TwoWay}" VerticalAlignment="Center" FontSize="11" />
              <Button Name="InterruptButton" AutomationProperties.AutomationId="InterruptButton"
                      Content="Interrupt (Esc)" Command="{Binding InterruptCommand}" />
              <Button Name="SendButton" AutomationProperties.AutomationId="SendButton"
                      Content="Send (Ctrl+Enter)" Command="{Binding SendPromptCommand}" Classes="accent"
                      ToolTip.Tip="{Binding SendButtonTooltip}" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- Transcript host. Task 0016: a Panel holding ONE transcript view per session, built
             lazily in MainWindow.axaml.cs (ShowTranscript) and toggled via IsVisible on focus
             change. Views are NEVER detached while their session lives: detaching a realized
             Markdown.Avalonia subtree changes its inherited ActualThemeVariant, which makes
             ColorTextBlock's DynamicResource-fed MultiBindings re-resolve Fluent *Color*
             resources straight into IBrush properties - InvalidCastException (Color -> IBrush)
             mid-ClearLogicalParent, corrupting the pane and ultimately crashing the app. Each
             view is wrapped in a ThemeVariantScope pinned to the window's variant so even the
             final removal (session close) can't trigger that cascade. The earlier designs -
             Content="{Binding FocusedSession}" (task 0014) and rebuild-ItemsControl-per-switch
             (task 0015) - both swapped content through a ContentControl and hit either container
             recycling or the detach cascade above. -->
        <ScrollViewer Name="TranscriptScroll" Padding="12,12,12,16">
          <Panel Name="TranscriptHost" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </DockPanel>

      <!-- Inspector -->
      <Border Grid.Column="3" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1,0,0,0" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Inspector" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedTaskNode.Title, FallbackValue='(no task selected)'}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedTaskNode.HomeCwd, FallbackValue=''}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
          <Separator Margin="0,4" />
          <TextBlock Text="Focused session" FontSize="11" Opacity="0.6" />
          <TextBlock Text="{Binding FocusedSession.Cwd, FallbackValue='(no session focused)'}" TextWrapping="Wrap" Opacity="0.85" />

          <Separator Margin="0,4" />
          <TextBlock Text="Model" FontSize="11" Opacity="0.6" />
          <TextBlock Text="{Binding FocusedSession.ModelDisplay, FallbackValue='(no session focused)'}"
                     TextWrapping="Wrap" Opacity="0.85" />
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{Binding InspectorModelChoices}"
                    SelectedItem="{Binding SelectedInspectorModel, Mode=TwoWay}"
                    IsEnabled="{Binding FocusedSession.IsAlive, FallbackValue=False}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Apply (respawn)" HorizontalAlignment="Stretch"
                  Command="{Binding ApplyModelCommand}"
                  ToolTip.Tip="Changing the model kills this session and spawns a fresh one in the same folder/task. Transcript history does not carry across." />
          <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                     Text="claude's model is fixed for a session's life. Applying a different model respawns the session (a task-bound session re-seeds from its pointer; transcript history is not preserved)." />

          <Separator Margin="0,4" />
          <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                     Text="Phase 3B. Tool calls park in the focused session's approval banner above the transcript; auto-mode (light-model safety review) wiring lands in a later slice." />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
